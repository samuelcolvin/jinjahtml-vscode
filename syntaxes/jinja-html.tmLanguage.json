{
  "name": "jinja-html",
  "scopeName": "text.html.jinja",
  "comment": "Jinja HTML Templates",
  "firstLineMatch": "^{% extends [\"'][^\"']+[\"'] %}",
  "foldingStartMarker": "^\\s*(<(?i:(head|table|tr|div|style|script|ul|ol|form|dl))\\b.*?>|{%\\s*(block|filter|for|if|macro|raw)\\s.*%})",
  "foldingStopMarker": "^\\s*(</(?i:(head|table|tr|div|style|script|ul|ol|form|dl))\\b.*?>|{%\\s*(endblock|endfilter|endfor|endif|endmacro|endraw)\\s*%})",
  "patterns": [
    {
      "include": "source.jinja"
    },
    {
      "include": "text.html.basic"
    }
  ]
}
